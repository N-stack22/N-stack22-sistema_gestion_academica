SUPABASE_URL=https://yrylzgosmrmvichwdrin.supabase.co

# Para el backend local usa la SERVICE ROLE KEY (no la anon key)
# Supabase -> Project Settings -> API -> service_role (secret)
SUPABASE_KEY=tu_service_role_key_aqui
# Railway tambien acepta este alias si prefieres ese nombre:
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Conexión PostgreSQL directa (Supabase -> Connect -> ORM -> copiar URI)
# Reemplaza [YOUR-PASSWORD] por la contraseña de Database (Settings -> Database).
# Para FastAPI + funciones SQL use la de puerto 5432 (session mode):
DATABASE_URL=postgresql://postgres.yrylzgosmrmvichwdrin:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

CORS_ORIGINS=http://localhost:4200,https://USUARIO.github.io
ENVIRONMENT=development

# Pool PostgreSQL usado por DATABASE_URL para dashboards/listados optimizados.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_MAX_IDLE_SECONDS=60
DB_POOL_MAX_LIFETIME_SECONDS=900

# Cache opcional para funciones SQL STABLE. Mantener desactivada para evitar listados obsoletos.
DB_FUNCTION_CACHE_ENABLED=false
DB_FUNCTION_CACHE_TTL_SECONDS=0
